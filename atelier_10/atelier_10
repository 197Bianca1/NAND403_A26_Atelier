
import random

from maya import cmds

from PySide6.QtWidgets import (
    QWidget,
    QVBoxLayout,
    QFormLayout,
    QSpinBox,
    QDoubleSpinBox,
    QPushButton,
    QMessageBox
)

from PySide6.QtCore import Qt


class Scatter(QWidget):

    def __init__(self):
        super().__init__()

        self.setWindowTitle("Scatter")
        self.setMinimumWidth(250)

        # Always on Top
        self.setWindowFlags(
            self.windowFlags() | Qt.WindowStaysOnTopHint
        )

        self.group = None
        self.source = None

        self.build_ui()

    def build_ui(self):

        layout = QVBoxLayout(self)
        form = QFormLayout()

        layout.addLayout(form)

        # Nombre de copies
        self.count_spin = QSpinBox()
        self.count_spin.setRange(1, 100)
        self.count_spin.setValue(10)

        form.addRow("Copies", self.count_spin)

        # Rayon de distribution
        self.radius_spin = QDoubleSpinBox()
        self.radius_spin.setRange(1.0, 50.0)
        self.radius_spin.setValue(10.0)

        form.addRow("Radius", self.radius_spin)

        # Seed aléatoire
        self.seed_spin = QSpinBox()
        self.seed_spin.setRange(0, 9999)

        form.addRow("Seed", self.seed_spin)

        # Bouton Scatter
        scatter_button = QPushButton("Scatter")
        scatter_button.clicked.connect(self.scatter)

        layout.addWidget(scatter_button)

        # Live Edit
        self.count_spin.valueChanged.connect(self.live_edit)
        self.radius_spin.valueChanged.connect(self.live_edit)
        self.seed_spin.valueChanged.connect(self.live_edit)

    def scatter(self):

        selection = cmds.ls(selection=True, transforms=True)

        if not selection:
            QMessageBox.warning(
                self,
                "Scatter",
                "Select an object first."
            )
            return

        self.source = selection[0]

        cmds.undoInfo(openChunk=True)

        try:

            # Création du groupe
            if not self.group or not cmds.objExists(self.group):
                self.group = cmds.group(
                    empty=True,
                    name="scatter_grp"
                )

            self.live_edit()

        finally:
            cmds.undoInfo(closeChunk=True)

    def live_edit(self):

        if not self.source:
            return

        if not cmds.objExists(self.source):
            return

        if not self.group or not cmds.objExists(self.group):
            return

        cmds.undoInfo(openChunk=True)

        try:

            # Supprimer les anciennes copies
            children = cmds.listRelatives(
                self.group,
                children=True,
                type="transform"
            ) or []

            if children:
                cmds.delete(children)

            # Initialiser le hasard
            random.seed(self.seed_spin.value())

            radius = self.radius_spin.value()

            # Créer les nouvelles copies
            for i in range(self.count_spin.value()):

                copy = cmds.duplicate(self.source)[0]

                cmds.parent(copy, self.group)

                x = random.uniform(-radius, radius)
                z = random.uniform(-radius, radius)

                cmds.move(
                    x,
                    0,
                    z,
                    copy,
                    relative=True
                )

        finally:
            cmds.undoInfo(closeChunk=True)


def show_tool():

    global tool_window

    try:
        tool_window.close()
    except Exception:
        pass

    tool_window = Scatter()
    tool_window.show()


show_tool()